type: ItemTurret
name: "Осадная Гаубица 'Молот'"
description: "Запускает сверхтяжелый снаряд. При попадании создает цепочку взрывов, прошивающих базу врага насквозь."
size: 4
health: 4500
range: 480
ammoPerShot: 15
reload: 500
rotateSpeed: 1 // Добавлено для баланса тяжелого орудия

// Потребление энергии перенесено в блок consumes
consumes: {
  power: 8.0
}

recoil: 8
shootShake: 10 // Немного увеличен тряс экрана для веса
shootSound: mediumCannon
heatColor: ff4500

shootEffect: shootBig
smokeEffect: shootSmokeTitan

ammoTypes: {
  blast-compound: {
    type: ArtilleryBulletType
    speed: 3
    damage: 150
    splashDamage: 200
    splashDamageRadius: 45
    width: 25
    height: 25
    lifetime: 160
    hittable: true
    ammoMultiplier: 1
    
    // Эффекты основного снаряда
    trailLength: 20
    trailWidth: 5
    trailColor: ff7924
    frontColor: ffffff
    backColor: ff7924
    
    hitEffect: blastExplosion
    despawnEffect: blastExplosion
    
    // Настройка каскада
    fragBullets: 1
    fragCone: 0         // Осколок летит строго вперед по курсу
    fragVelocityMin: 1
    fragVelocityMax: 1
    
    fragBullet: {
      type: ArtilleryBulletType
      damage: 180
      speed: 4
      lifetime: 10 // Летит вперед 10 тиков (40 пикселей) и взрывается
      splashDamage: 200
      splashDamageRadius: 50
      
      width: 15
      height: 15
      trailLength: 8
      trailWidth: 3
      trailColor: ff4500
      frontColor: ffffff
      backColor: ff4500
      
      hitEffect: blastExplosion
      despawnEffect: blastExplosion
      
      fragBullets: 1
      fragCone: 0       // Второй осколок продолжает движение строго вперед
      fragVelocityMin: 1
      fragVelocityMax: 1
      
      fragBullet: {
        type: ArtilleryBulletType
        damage: 220
        speed: 4
        lifetime: 10 // Пролетает еще 40 пикселей и ставит финальную точку
        splashDamage: 250
        splashDamageRadius: 60
        
        width: 10
        height: 10
        trailLength: 4
        trailWidth: 2
        trailColor: e60000
        frontColor: ffffff
        backColor: e60000
        
        hitEffect: massiveExplosion
        despawnEffect: massiveExplosion
      }
    }
  }
}

requirements: [
  titanium/500
  thorium/350
  silicon/300
  plastanium/150
]

category: turret
research: mortar