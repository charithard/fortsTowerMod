type: ItemTurret
name: "Тяжелый миномет"
description: "Тяжелое осадное орудие. Запускает массивные снаряды по сверхвысокой траектории. Обладает огромным радиусом поражения и способностью пробивать прочную обшивку."
size: 3
health: 1400
range: 360
ammoPerShot: 3

reload: 240
inaccuracy: 5
rotateSpeed: 2 

shootSound: mediumCannon
recoil: 5
shootShake: 4
heatColor: ff4500

// Мощный кастомный визуальный выстрел (вспышка, дым, волна)
shootEffect: [
    {
        type: ParticleEffect
        particles: 8
        cone: 25
        length: 24
        lenFrom: 8
        lenTo: 0
        sizeFrom: 5
        sizeTo: 0
        colorFrom: ffd37f
        colorTo: e65c00
        lifetime: 15
    }
    {
        type: WaveEffect
        sizeFrom: 0
        sizeTo: 28
        strokeFrom: 4
        strokeTo: 0
        colorFrom: ffd37f
        colorTo: e65c0000
        lifetime: 18
    }
]

smokeEffect: {
    type: ParticleEffect
    particles: 6
    cone: 40
    length: 30
    sizeFrom: 4
    sizeTo: 0
    colorFrom: 6b6b6b
    colorTo: 4a4a4a00
    lifetime: 45
}

ammoTypes: {
  thorium: {
    type: ArtilleryBulletType
    speed: 3.5
    damage: 40
    splashDamage: 120
    splashDamageRadius: 45
    width: 15
    height: 15
    lifetime: 110
    ammoMultiplier: 2
    frontColor: f9c5d1
    backColor: cb8ebf
    
    // Красивый шлейф тория
    trailLength: 12
    trailWidth: 3.5
    trailColor: cb8ebf
    
    // Кастомный взрыв вместо дефолтного
    hitEffect: [
        {
            type: ParticleEffect
            particles: 10
            length: 35
            sizeFrom: 4
            sizeTo: 0
            colorFrom: f9c5d1
            colorTo: cb8ebf00
            lifetime: 25
        }
        {
            type: WaveEffect
            sizeFrom: 0
            sizeTo: 45
            strokeFrom: 3
            strokeTo: 0
            colorFrom: f9c5d1
            colorTo: cb8ebf00
            lifetime: 20
        }
    ]
    despawnEffect: flakExplosion
  }
  
  blast-compound: {
    type: ArtilleryBulletType
    speed: 3
    damage: 30
    splashDamage: 160
    splashDamageRadius: 60
    status: blasted
    makeFire: true
    lifetime: 120
    ammoMultiplier: 3
    
    // Огненный шлейф взрывчатки
    trailLength: 15
    trailWidth: 4
    trailColor: ff7912
    
    hitEffect: massiveExplosion
    despawnEffect: massiveExplosion
  }
  
  pyratite: {
    type: ArtilleryBulletType
    speed: 3.2
    damage: 25
    splashDamage: 80
    splashDamageRadius: 50
    makeFire: true
    status: burning
    lifetime: 115
    ammoMultiplier: 4
    
    // Яркий шлейф пиратита
    trailLength: 10
    trailWidth: 3
    trailColor: ffa126
    
    // Эффект зажигательного взрыва
    hitEffect: [
        {
            type: ParticleEffect
            particles: 12
            length: 25
            sizeFrom: 3
            sizeTo: 0
            colorFrom: ffa126
            colorTo: ff4500
            lifetime: 30
        }
    ]
    despawnEffect: fireSmoke
  }
}

requirements: [
  copper/250
  lead/200
  titanium/120
  thorium/50
]

category: turret
research: mortar