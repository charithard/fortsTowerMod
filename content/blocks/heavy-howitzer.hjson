type: ItemTurret
name: "Тяжелая Гаубица"
description: "Ультимативное осадное орудие. Запускает огромные, медленные снаряды по высокой траектории. Снаряд крайне уязвим для ПВО, но одно попадание способно стереть базу с лица земли."
size: 4
health: 4000
range: 480 
ammoPerShot: 15

reload: 480
rotateSpeed: 1.2

// Потребление энергии перенесено в правильный блок
consumes: {
  power: 6.0
}

recoil: 10
shootShake: 12
shootSound: explosionbig
heatColor: ff1100

// Эпический выстрел: колоссальная волна и облако дыма вокруг турели
shootEffect: [
    {
        type: WaveEffect
        sizeFrom: 0
        sizeTo: 60
        strokeFrom: 8
        strokeTo: 0
        colorFrom: ffa52d
        colorTo: ff330000
        lifetime: 30
    }
    {
        type: ParticleEffect
        particles: 15
        cone: 40
        length: 50
        sizeFrom: 6
        sizeTo: 0
        colorFrom: ffa52d
        colorTo: ff110000
        lifetime: 25
    }
]

smokeEffect: {
    type: ParticleEffect
    particles: 12
    cone: 360 // Дым расходится во все стороны от орудия
    length: 40
    sizeFrom: 5
    sizeTo: 0
    colorFrom: 5a5a5a
    colorTo: 3a3a3a00
    lifetime: 80
}

ammoTypes: {
  thorium: {
    type: ArtilleryBulletType
    speed: 2.5
    damage: 300
    splashDamage: 600
    splashDamageRadius: 80
    width: 25
    height: 25
    shrinkY: 0
    lifetime: 200
    
    // Параметры уязвимости для ПВО
    hittable: true
    absorbable: true
    ammoMultiplier: 1
    
    // Огромный фиолетовый шлейф
    trailLength: 25
    trailWidth: 6
    trailColor: cb8ebf
    frontColor: f9c5d1
    backColor: cb8ebf
    
    // Кастомный ядерный микровзрыв под радиус 80
    hitEffect: [
        {
            type: WaveEffect
            sizeFrom: 0
            sizeTo: 80
            strokeFrom: 5
            strokeTo: 0
            colorFrom: f9c5d1
            colorTo: cb8ebf00
            lifetime: 30
        }
        {
            type: ParticleEffect
            particles: 20
            length: 75
            sizeFrom: 5
            sizeTo: 0
            colorFrom: f9c5d1
            colorTo: cb8ebf00
            lifetime: 40
        }
    ]
    despawnEffect: massiveExplosion
  }
  
  blast-compound: {
    type: ArtilleryBulletType
    speed: 2
    damage: 200
    splashDamage: 800
    splashDamageRadius: 100
    makeFire: true
    status: blasted
    statusDuration: 600
    width: 30
    height: 30
    lifetime: 240
    
    hittable: true
    ammoMultiplier: 1
    
    // Пылающий хвост метеорита
    trailLength: 30
    trailWidth: 8
    trailColor: ff5500
    frontColor: ffd37f
    backColor: ff5500
    
    // ReactorExplosion — отличный выбор для радиуса 100
    hitEffect: reactorExplosion
    despawnEffect: reactorExplosion
  }
}

requirements: [
  copper/1000
  lead/800
  titanium/400
  thorium/250
  silicon/300
  plastanium/100
]

category: turret
research: heavy-mortar