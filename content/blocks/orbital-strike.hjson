type: ItemTurret
name: "Спутниковый целеуказатель 'Возмездие'"
description: "Запускает тяжелый бронированный маяк. При приземлении маяк активирует мощнейший вертикальный орбитальный лазер, прожигающий всё в зоне действия в течение нескольких секунд. Сбейте маяк до падения!"
size: 4
health: 6000 
range: 550
reload: 800
ammoPerShot: 25

consumePower: 35.0 
rotateSpeed: 1.0

ammoTypes: {
  surge-alloy: { 
    type: MissileBulletType
    speed: 1.8
    damage: 50
    width: 32
    height: 32
    shrinkY: 0
    lifetime: 310
    
    hittable: true
    absorbable: true
    health: 450
    
    fragBullets: 1
    fragVelocityMin: 0
    fragVelocityMax: 0
    fragBullet: {
      type: BulletType
      damage: 0
      lifetime: 180
      speed: 0
      
      hitEffect: massiveExplosion
      shootEffect: shootBig
      
      onUpdateEffect: {
        type: MultiEffect
        effects: [
          { 
            type: LaserBulletType
            damage: 2200
            length: 1200
            width: 120
            colors: [ffcc66, ffffff, ffffff]
            rotationOffset: 90 
            makeFire: true
          },
          { 
            type: ParticleEffect
            particles: 25
            length: 80
            lifetime: 50
            colorFrom: ffcc66
          }
        ]
      }
    }
  }
}

requirements: [
  thorium/600
  plastanium/300
  surge-alloy/250
]

category: turret
research: heavy-howitzer