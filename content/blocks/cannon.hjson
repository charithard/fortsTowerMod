type: ItemTurret
name: "Пушка"
description: "Тяжелое орудие прямой наводки. Выстреливает высокоскоростным кинетическим снарядом, который легко проходит сквозь несколько слоев брони."
size: 3
health: 1500
range: 260
ammoPerShot: 5

reload: 150
rotateSpeed: 4
inaccuracy: 0 

// Потребление энергии перенесено в блок consumes
consumes: {
  power: 1.2
}

recoil: 5
shootShake: 4
shootSound: cannon
heatColor: ff5d00

// Эффект мощного выстрела: плотное облако газов и резкая ударная волна
shootEffect: [
    {
        type: WaveEffect
        sizeFrom: 0
        sizeTo: 24
        strokeFrom: 4
        strokeTo: 0
        colorFrom: ffd37f
        colorTo: ff5d0000
        lifetime: 15
    }
    {
        type: ParticleEffect
        particles: 6
        cone: 15
        length: 25
        sizeFrom: 4
        sizeTo: 0
        colorFrom: ffd37f
        colorTo: ff5d0000
        lifetime: 12
    }
]

smokeEffect: {
    type: ParticleEffect
    particles: 4
    cone: 25
    length: 30
    sizeFrom: 3
    sizeTo: 0
    colorFrom: 8a8a8a
    colorTo: 5a5a5a00
    lifetime: 35
}

ammoTypes: {
  graphite: {
    type: BasicBulletType // Добавлено
    speed: 12
    damage: 120
    width: 10
    height: 22
    lifetime: 22
    pierce: true
    pierceCap: 3 
    ammoMultiplier: 1
    
    // Плотный серый трассер
    trailLength: 15
    trailWidth: 2.2
    trailColor: 95abd9
    frontColor: e2e9f5
    backColor: 95abd9
    
    // Искры при попадании в броню
    hitEffect: [
        {
            type: ParticleEffect
            particles: 5
            length: 15
            sizeFrom: 2.5
            sizeTo: 0
            colorFrom: e2e9f5
            colorTo: 95abd900
            lifetime: 15
        }
    ]
    despawnEffect: hitBulletColor
  }
  
  titanium: {
    type: BasicBulletType // Добавлено
    speed: 14
    damage: 160
    width: 12
    height: 26
    lifetime: 19
    pierce: true
    pierceCap: 4
    ammoMultiplier: 1
    reloadMultiplier: 1.1
    
    // Яркий синий высокоскоростной след
    trailLength: 18
    trailWidth: 2.8
    trailColor: a4c2f4
    frontColor: ffffff
    backColor: 769cd6
    
    hitEffect: [
        {
            type: ParticleEffect
            particles: 6
            length: 18
            sizeFrom: 3
            sizeTo: 0
            colorFrom: a4c2f4
            colorTo: 769cd600
            lifetime: 18
        }
    ]
    despawnEffect: flakExplosion
  }
}

requirements: [
  lead/250
  graphite/150
  titanium/60
]

category: turret
research: sniper