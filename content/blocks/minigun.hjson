type: ItemTurret
name: "Пулемет Forts"
description: "Базовое скорострельное орудие. Выпускает очереди по 3 снаряда. Эффективен для подавления пехоты и защиты от ракет."
size: 2
health: 600
range: 170
ammoPerShot: 1

shoot: {
    type: ShootAlternate
    shots: 3
    shotDelay: 4
    barrels: 1     
    barrelSpread: 1     
}

reload: 18
inaccuracy: 7.5
rotateSpeed: 10

recoil: 1.5
shootShake: 0.8
shootSound: pew
heatColor: ffa564

// вспышка из дула при каждом выстреле
shootEffect: [
    {
        type: ParticleEffect
        particles: 3
        cone: 20
        length: 6
        lenFrom: 4
        lenTo: 0
        sizeFrom: 3
        sizeTo: 0
        colorFrom: ffe3b8
        colorTo: ffa564
        lifetime: 8
        lightColor: ffcf8a
        lightOpacity: 0.6
        lightRadius: 20
    }
    {
        type: WaveEffect
        sizeFrom: 1
        sizeTo: 10
        strokeFrom: 2
        strokeTo: 0
        colorFrom: ffe3b8
        colorTo: ffa56400
        lifetime: 10
    }
]

// лёгкий дым/гильзы после выстрела
smokeEffect: {
    type: ParticleEffect
    particles: 2
    cone: 30
    length: 10
    sizeFrom: 1.5
    sizeTo: 0
    colorFrom: cfcfcf
    colorTo: cfcfcf00
    lifetime: 25
}

