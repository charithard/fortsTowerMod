type: ItemTurret
name: "Зенитная установка (Flak)"
description: "Оборонительное орудие для борьбы с воздушными целями и снарядами. Снаряды взрываются в воздухе, выпуская облако осколков."
size: 2
health: 700
range: 200
targetAir: true
targetGround: true
ammoPerShot: 2

// Двуствольное чередование для аутентичного темпа зенитки
shoot: {
    type: ShootAlternate
    barrels: 2
    barrelSpread: 4
}

reload: 35
inaccuracy: 3
rotateSpeed: 12 

shootSound: shootSnap
recoil: 2
shootShake: 1
heatColor: ffa564

shootEffect: shootSmall
smokeEffect: shootSmokeMissile

ammoTypes: {
  lead: {
    type: FlakBulletType
    speed: 5
    damage: 15
    splashDamage: 25
    splashDamageRadius: 30
    explodeRange: 20
    collidesGround: true
    ammoMultiplier: 4
    
    // Визуал основного снаряда
    width: 8
    height: 10
    trailLength: 6
    trailWidth: 1.5
    trailColor: abbcda
    frontColor: ffffff
    backColor: abbcda
    hitEffect: flakExplosion
    despawnEffect: flakExplosion

    fragBullets: 4
    fragBullet: {
      type: BasicBulletType
      damage: 5
      speed: 2
      lifetime: 10
      width: 3
      height: 6
      frontColor: ffffff
      backColor: abbcda
    }
  }
  
  graphite: {
    type: FlakBulletType
    speed: 6
    damage: 20
    splashDamage: 35
    splashDamageRadius: 35
    explodeRange: 25
    collidesGround: true
    ammoMultiplier: 3
    
    width: 9
    height: 11
    trailLength: 8
    trailWidth: 2
    trailColor: 95abd9
    frontColor: e2e9f5
    backColor: 95abd9
    hitEffect: flakExplosion
    despawnEffect: flakExplosion

    fragBullets: 6
    fragBullet: {
      type: BasicBulletType
      damage: 8
      speed: 2.5
      lifetime: 12
      width: 4
      height: 7
      frontColor: e2e9f5
      backColor: 95abd9
    }
  }
  
  metaglass: {
    type: FlakBulletType
    speed: 5.5
    damage: 12
    splashDamage: 40
    splashDamageRadius: 40
    explodeRange: 30
    collidesGround: true
    ammoMultiplier: 5
    
    width: 8
    height: 12
    trailLength: 10
    trailWidth: 1.8
    trailColor: ffffff
    frontColor: ffffff
    backColor: dcdcdc
    
    // Исправлено: заменено на стандартный взрыв зенитки
    hitEffect: flakExplosion
    despawnEffect: flakExplosion

    fragBullets: 8
    fragBullet: {
      type: BasicBulletType
      damage: 4
      speed: 3
      lifetime: 15
      width: 3
      height: 8
      
      frontColor: ffffff
      backColor: e0e0e080 
      hitEffect: none
      despawnEffect: none
    }
  }
}

requirements: [
  copper/120
  lead/150
  graphite/40
]

category: turret
research: minigun