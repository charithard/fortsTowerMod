type: ItemTurret
name: "Тяжелый пулемет"
description: "Тяжелая многоствольная установка. Выпускает сокрушительный залп из 15 пуль, после чего требует длительного времени на охлаждение и перезарядку."
size: 2
health: 1200
range: 220
ammoPerShot: 1

// Потребление энергии для вращения массивных стволов
consumePower: 0.75

// Тот самый залп из 15 пуль
shoot: {
    type: ShootBurst
    shots: 15
    shotDelay: 3 // Очень быстрый вылет пуль внутри очереди
}

// Перезарядка в 4 секунды (4 * 60 кадров = 240)
reload: 240

// Уменьшенный разброс для стрельбы на большую дистанцию
inaccuracy: 4
rotateSpeed: 5

recoil: 3
shootShake: 2
shootSound: shootBig

ammoTypes: {
  graphite: {
    speed: 5.5
    damage: 20
    width: 8
    height: 12
    lifetime: 45
    ammoMultiplier: 10 // Увеличил, чтобы одного графита хватало на весь залп
    pierce: true
    pierceCap: 2
  }
  titanium: {
    speed: 6.5
    damage: 25
    width: 9
    height: 13
    lifetime: 40
    ammoMultiplier: 10
    reloadMultiplier: 1.1 // На титане чуть быстрее остывает
  }
  thorium: {
    speed: 6
    damage: 35
    width: 10
    height: 14
    lifetime: 42
    ammoMultiplier: 8
    shootEffect: shootBig
  }
}

requirements: [
  copper/180
  lead/140
  titanium/60
]

category: turret
research: minigun