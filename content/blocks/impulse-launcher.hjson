type: ItemTurret
name: "Установка 'Импульс'"
description: "Выпускает специализированные ракеты с электромагнитным зарядом. Выводит из строя электронику врага, замедляя его действия."
size: 3
health: 1200
range: 380
ammoPerShot: 5

chargeTime: 90
chargeEffect: {
    type: ParticleEffect
    particles: 10
    cone: 25
    length: 20
    sizeFrom: 1
    sizeTo: 3
    colorFrom: cfcfcf
    colorTo: cfcfcf00
    lifetime: 90
}
chargeSound: release

reload: 240
rotateSpeed: 3

shootSound: release
recoil: 2
shootShake: 3

// === Череда ракет: несколько "стволов", вылетают одна за другой ===
shoot: {
    type: ShootBarrel
    barrels: [
        -8, 10, 0,
        8, 10, 0,
        -4, 12, 2,
        4, 12, 2,
        0, 14, 4
    ]
    shotDelay: 8
}

ammoTypes: {

    // --- Базовый боеприпас: 5 ракет (по числу barrels), без доп. довылета ---
    silicon: {
        type: MissileBulletType

        // === ПРОВЕРИТЬ В ИГРЕ (2): срабатывает ли fragBullets по истечении lifetime
        // без попадания в цель, либо только при прямом хите. От этого зависит,
        // будет ли двухступенчатый разгон работать как задумано. ===

        // --- стадия 1: медленный разгонный снаряд, его можно сбить ---
        speed: 1.6
        lifetime: 12
        damage: 0
        hitSize: 6
        hittable: true
        homingPower: 0.02
        width: 8
        height: 10
        trailLength: 3
        trailWidth: 1
        trailColor: 8ca9ff
        frontColor: 8ca9ff
        backColor: 5a82ff
        despawnEffect: none
        hitEffect: none

        fragBullets: 1
        fragRandomSpread: 0
        fragVelMin: 1
        fragVelMax: 1
        fragBullet: {
            // --- стадия 2: крейсерский полёт на постоянной скорости, тоже сбиваемый ---
            type: MissileBulletType
            speed: 4.2
            damage: 10
            splashDamage: 10
            splashDamageRadius: 80

            status: emp-paralysis
            statusDuration: 300

            width: 10
            height: 14
            shrinkY: 0
            lifetime: 90
            hittable: true
            homingPower: 0.08
            homingRange: 50

            frontColor: 8ca9ff
            backColor: 5a82ff
            trailColor: 8ca9ff
            trailLength: 5
            trailWidth: 1.2

            hitEffect: {
                type: WaveEffect
                colorFrom: 8ca9ff
                colorTo: 5a82ff
                sizeTo: 80
                lifetime: 30
            }
            despawnEffect: blastExplosion
        }
    }

    // --- Дорогой боеприпас: та же череда, но каждая ракета довыпускает ещё 2 доп. ракеты в полёте ---
    plastanium: {
        type: MissileBulletType

        speed: 1.6
        lifetime: 12
        damage: 0
        hitSize: 6
        hittable: true
        homingPower: 0.02
        width: 8
        height: 10
        trailLength: 3
        trailWidth: 1
        trailColor: 8ca9ff
        frontColor: 8ca9ff
        backColor: 5a82ff
        despawnEffect: none
        hitEffect: none

        fragBullets: 1
        fragRandomSpread: 0
        fragVelMin: 1
        fragVelMax: 1
        fragBullet: {
            type: MissileBulletType
            speed: 4.2
            damage: 10
            splashDamage: 10
            splashDamageRadius: 80

            status: emp-paralysis
            statusDuration: 300

            width: 10
            height: 14
            shrinkY: 0
            lifetime: 95
            hittable: true
            homingPower: 0.08
            homingRange: 50

            frontColor: 8ca9ff
            backColor: 5a82ff
            trailColor: 8ca9ff
            trailLength: 5
            trailWidth: 1.2

            // доп. ракеты, довылетающие уже во время крейсерского полёта родительской
            bulletInterval: 12
            intervalBullets: 2
            intervalBullet: {
                type: MissileBulletType
                speed: 4
                damage: 8
                splashDamage: 8
                splashDamageRadius: 60
                status: emp-paralysis
                statusDuration: 300
                hittable: true
                homingPower: 0.08
                width: 8
                height: 12
                lifetime: 90
                frontColor: 8ca9ff
                backColor: 5a82ff
                trailColor: 8ca9ff
                hitEffect: {
                    type: WaveEffect
                    colorFrom: 8ca9ff
                    colorTo: 5a82ff
                    sizeTo: 60
                    lifetime: 25
                }
                despawnEffect: blastExplosion
            }

            hitEffect: {
                type: WaveEffect
                colorFrom: 8ca9ff
                colorTo: 5a82ff
                sizeTo: 80
                lifetime: 30
            }
            despawnEffect: blastExplosion
        }
    }
}

requirements: [
    lead/200
    titanium/150
    silicon/120
]

category: turret
research: swarm-launcher
