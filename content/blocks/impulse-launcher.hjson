type: ItemTurret
name: "Установка 'Импульс'"
description: "Выпускает специализированные ракеты с электромагнитным зарядом. Выводит из строя электронику врага, замедляя его действия."
size: 3
health: 1200
range: 380
ammoPerShot: 5

reload: 240 // Перезарядка 4 секунды
rotateSpeed: 3

shootSound: release
recoil: 2

ammoTypes: {
  // ЭМИ-заряд (требует Кремний и Титан)
  silicon: {
    type: MissileBulletType
    speed: 4
    damage: 10 // Почти нет прямого урона
    
    // Радиус действия импульса
    splashDamage: 10
    splashDamageRadius: 80 
    
    // Наложение нашего эффекта
    status: emp-paralysis
    statusDuration: 300 // Длится 5 секунд (300 кадров)
    
    width: 10
    height: 14
    shrinkY: 0
    lifetime: 95
    
    hittable: true // Ракету можно сбить!
    homingPower: 0.08
    
    // Визуал синих молний при взрыве
    hitEffect: {
      type: WaveEffect
      colorFrom: 8ca9ff
      colorTo: 5a82ff
      sizeTo: 80
      lifetime: 30
    }
    despawnEffect: blastExplosion
    
    frontColor: 8ca9ff
    backColor: 5a82ff
    trailColor: 8ca9ff
  }
}

requirements: [
  lead/200
  titanium/150
  silicon/120
]

category: turret
research: swarm-launcher