type: ItemTurret
name: "Улучшенная Тяжелая Пушка"
description: "Модернизированная версия обычного орудия. Использует усиленные механизмы разгона снаряда. Прошивает практически любую оборону насквозь."
size: 3
health: 2800
range: 380 
ammoPerShot: 10

reload: 350
rotateSpeed: 2

// Потребление энергии исправлено
consumes: {
  power: 4.5
}

recoil: 8
shootShake: 8
shootSound: explosionbig
heatColor: ff2200

// Эпический выхлоп сверхзвукового орудия
shootEffect: [
    {
        type: WaveEffect
        sizeFrom: 0
        sizeTo: 40
        strokeFrom: 6
        strokeTo: 0
        colorFrom: ffb859
        colorTo: ff220000
        lifetime: 20
    }
    {
        type: ParticleEffect
        particles: 10
        cone: 12
        length: 45
        sizeFrom: 5
        sizeTo: 0
        colorFrom: ffb859
        colorTo: ff5d0000
        lifetime: 15
    }
]

smokeEffect: {
    type: ParticleEffect
    particles: 6
    cone: 20
    length: 40
    sizeFrom: 4
    sizeTo: 0
    colorFrom: 9e9e9e
    colorTo: 61616100
    lifetime: 45
}

ammoTypes: {
  thorium: {
    type: BasicBulletType // Добавлено
    speed: 16
    damage: 450
    width: 15
    height: 35
    lifetime: 24
    pierce: true
    pierceCap: 10 
    
    // Огромный монолитный фиолетовый шлейф
    trailLength: 22
    trailWidth: 4
    trailColor: cb8ebf
    frontColor: f9c5d1
    backColor: cb8ebf
    
    hitEffect: massiveExplosion
    despawnEffect: massiveExplosion
    ammoMultiplier: 1
  }
  
  plastanium: {
    type: BasicBulletType // Добавлено
    speed: 20 
    damage: 380
    width: 14
    height: 40
    lifetime: 19
    pierce: true
    pierceCap: 15
    ammoMultiplier: 1
    
    // Сверхзвуковой зеленый шлейф пластаниума
    trailLength: 25
    trailWidth: 3.5
    trailColor: cbd97f
    frontColor:ffffff
    backColor: 98b832
    
    // Эффект разрушения пластаниума при попадании
    hitEffect: plasticExplosion
    despawnEffect: plasticExplosion

    fragBullets: 5
    fragBullet: {
       type: BasicBulletType // Добавлено, защищает от краша
       damage: 40
       speed: 5
       lifetime: 20
       width: 6
       height: 12
       
       // Осколки тоже делаем зелеными пластаниумовыми
       frontColor: ffffff
       backColor: 98b832
       trailLength: 5
       trailWidth: 1.5
       trailColor: cbd97f
    }
  }
}

requirements: [
  titanium/300
  thorium/150
  silicon/200
  plastanium/80
]

category: turret
research: cannon