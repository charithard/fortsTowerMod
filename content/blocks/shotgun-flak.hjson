type: ItemTurret
name: "Дробовик-Зенитка"
description: "Продвинутая защитная установка. Выстреливает широким веером осколков. Наносит сокрушительный урон вблизи, эффективна для зачистки неба от групп врагов."
size: 2
health: 1100
range: 180
targetAir: true
targetGround: true

reload: 50

// Изменено на ShootSpread для одновременного выстрела веером
shoot: {
    type: ShootSpread
    shots: 12
    spread: 25 // Угол веера, идеально сочетается с inaccuracy
}

inaccuracy: 25
rotateSpeed: 8

shootSound: shotgun
recoil: 4
shootShake: 2
heatColor: ff4500

// Мощный выхлоп газов при залпе картечи
shootEffect: shootBigSmoke
smokeEffect: shootSmokeSquare

ammoTypes: {
  graphite: {
    type: BasicBulletType // Добавлено
    speed: 7
    damage: 18
    width: 4
    height: 6
    shrinkY: 0.3 // Пуля красиво сужается к концу полета
    lifetime: 30
    ammoMultiplier: 4
    
    frontColor: e2e9f5
    backColor: 95abd9
    trailLength: 4
    trailWidth: 1
    trailColor: 95abd9
    hitEffect: hitBulletColor
    despawnEffect: hitBulletColor
  }
  
  titanium: {
    type: BasicBulletType // Добавлено
    speed: 8
    damage: 24
    width: 5
    height: 8
    shrinkY: 0.3
    lifetime: 30
    ammoMultiplier: 3
    pierce: true
    pierceCap: 2
    
    frontColor: ffffff
    backColor: 769cd6
    trailLength: 5
    trailWidth: 1.2
    trailColor: a4c2f4
    hitEffect: flakExplosion
    despawnEffect: flakExplosion
  }
  
  pyratite: {
    type: BasicBulletType
    speed: 6.5
    damage: 15
    width: 4
    height: 6
    makeFire: true
    status: burning
    lifetime: 35
    ammoMultiplier: 5
    
    frontColor: ffa126
    backColor: ff4500
    trailLength: 4
    trailWidth: 1
    trailColor: ffa126
    // Исправлено: fireball заменен на рабочий fireHit
    hitEffect: fireHit
    despawnEffect: fireHit
  }
}

requirements: [
  lead/200
  titanium/80
  graphite/60
]

category: turret
research: flak